# Copie para .env.local e ajuste se precisar.
# NEXT_PUBLIC_* vai para o navegador: aqui só entram endereços, nunca senha ou chave.

# Endereço da API (Spring Boot)
NEXT_PUBLIC_API_URL=http://localhost:8080
# Endereço deste site, usado para montar o link público que o dono compartilha
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opcional: endereço da API visto pelo servidor do Next (em produção pode ser interno)
# API_URL=http://localhost:8080

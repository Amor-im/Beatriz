# Copie este arquivo para .env (o .env não vai para o Git) e troque os valores.

# Banco (usado pelo docker-compose.yml e pela API)
POSTGRES_DB=agenda_facil
POSTGRES_USER=agenda
POSTGRES_PASSWORD=troque-esta-senha

# API
DB_URL=jdbc:postgresql://localhost:5432/agenda_facil
# Segredo que assina os tokens de login: pelo menos 32 caracteres aleatórios.
# Gere um com: openssl rand -base64 48
JWT_SEGREDO=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
# Endereço do front que pode chamar a API (CORS)
CORS_ORIGENS=http://localhost:3000
